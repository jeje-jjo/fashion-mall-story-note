rules_version = '2';

// 본인만 읽고 쓸 수 있게 막아 둔 규칙.
// 새 노트에서 처음 로그인한 구글 계정의 uid로 고정한다(2026-11-06).
// uid는 Firebase가 이 프로젝트 안에서 계정마다 한 번 만들어 주는 고유 번호라
// 이메일 주소를 바꾸거나 다른 로그인 방식을 붙여도 바뀌지 않는다.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid == '9dlSV6iYolauEAhEkRIZJktyox32';
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
